# Server settings
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string; keep real credentials in server/.env
MONGODB_URI=

# Generate a unique random secret and keep it in server/.env
JWT_SECRET=

# GitHub OAuth app credentials; configure the callback URL in GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Gemini API key; use it only in the backend
GEMINI_API_KEY=
